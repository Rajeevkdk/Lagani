{
  "name": "@lagani/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:seed": "tsx src/db-cli.ts seed",
    "test": "tsx --test test/domain.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@supabase/supabase-js": "2.118.0",
    "bcryptjs": "3.0.3",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "js-yaml": "5.4.1",
    "openai": "6.49.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "js-yaml": "5.4.1"
  }
}
